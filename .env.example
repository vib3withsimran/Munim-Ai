# ─────────────────────────────────────────────
#  Munim AI — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# ── WhatsApp Cloud API (Meta) ─────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0

# ── Owner's personal WhatsApp number ─────────
# Used to forward escalations and send daily summaries.
# Format: international without '+' e.g. 919876543210
OWNER_WHATSAPP_NUMBER=

# ── Google Sheets ─────────────────────────────
# Path to the service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=./backend/data/service_account.json
# The ID from the Google Sheet URL
GOOGLE_SHEET_ID=

# ── Gemini (Google AI) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Groq / Whisper (audio fallback) ──────────
GROQ_API_KEY=

# ── Application ───────────────────────────────
APP_ENV=development
# Secret used for signing internal tokens if needed
APP_SECRET_KEY=change-me-before-production
LOG_LEVEL=INFO

# ── SQLite database path ──────────────────────
DATABASE_URL=sqlite:///./backend/data/munim.db

